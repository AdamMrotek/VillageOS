# Local-stack values only — safe to commit. These are the Supabase CLI's
# shared local defaults plus our committed local signing key; none of them
# work against any hosted project.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Dedicated e2e API port — like web on :3100, never shared with `make backend`
# on :8000, so reuseExistingServer can't latch onto a real-LLM dev server.
NEXT_PUBLIC_API_URL=http://localhost:8100

# apps/api (fake-LLM e2e server; CLI shared local defaults, safe to commit)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# SUPABASE_SECRET_KEY is intentionally NOT committed: it's the CLI's shared
# local default (works only against 127.0.0.1) but GitHub push protection flags
# the sb_secret_ prefix. playwright.config.ts pulls it from `supabase status`
# on the running stack. To run apps/api outside Playwright, export it yourself:
#   export SUPABASE_SECRET_KEY=$(supabase status -o env | sed -n 's/^SECRET_KEY="\?\([^"]*\)"\?/\1/p')

# Seeded test users (supabase/seed.sql)
E2E_USER_A_EMAIL=e2e-a@test.local
E2E_USER_A_PASSWORD=e2e-password-a
E2E_USER_B_EMAIL=e2e-b@test.local
E2E_USER_B_PASSWORD=e2e-password-b
