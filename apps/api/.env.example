# Supabase — copy from your Supabase dashboard → Project Settings → API Keys
SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_...) — used for user-scoped clients; RLS enforced.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (sb_secret_...) — server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# LLM provider — openai or groq
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
GROQ_API_KEY=

# Comma-separated origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000

# Provider-cover uploads (presigned S3 POST → served via CloudFront). Created by
# the SAM stack; read the values from `sam deploy` outputs. Cover upload won't
# work locally without these + AWS credentials, but the rest of the app is fine.
PROVIDER_COVER_BUCKET=villageos-providercoverbucket-...
PROVIDER_COVER_CDN_DOMAIN=dxxxxxxxxxxxxx.cloudfront.net

# Log verbosity (default INFO). Set to DEBUG to also log the full prompt
# (extraction_prompt) and extracted payload (extraction_result) — user content.
LOG_LEVEL=INFO
