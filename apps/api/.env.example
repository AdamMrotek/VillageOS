# Supabase — copy from your Supabase dashboard → Project Settings → API Keys
SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_...) — used for user-scoped clients; RLS enforced.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (sb_secret_...) — server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# LLM provider — openai or groq
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
GROQ_API_KEY=

# Online experiment (move 1) — A/B on the extraction model. Self-hosted (ADR-023):
# control lives in the `experiments` Supabase row (enabled=false by default, so
# every caller gets the prod default and behaviour is unchanged). When enabled the
# experiment needs BOTH provider keys above; SUPABASE_SECRET_KEY (above) gates
# whether assignment config is read and events are captured. No PostHog key.

# Comma-separated origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000

# Provider-cover uploads (presigned S3 POST → served via CloudFront). Created by
# the SAM stack; read the values from `sam deploy` outputs. Cover upload won't
# work locally without these + AWS credentials, but the rest of the app is fine.
PROVIDER_COVER_BUCKET=villageos-providercoverbucket-...
PROVIDER_COVER_CDN_DOMAIN=dxxxxxxxxxxxxx.cloudfront.net

# Event-change emails (the notification worker). none = send nothing and leave
# the outbox pending; log = write each email to the log (local dev); ses = send
# through Amazon SES (needs AWS credentials and a verified identity).
EMAIL_PROVIDER=none
EMAIL_FROM=VillageOS <events@notify.villageos.co.uk>
# Web app base URL, for links in emails.
APP_URL=http://localhost:3000

# Log verbosity (default INFO). Set to DEBUG to also log the full prompt
# (extraction_prompt) and extracted payload (extraction_result) — user content.
LOG_LEVEL=INFO
